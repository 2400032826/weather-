# ========================================================
# RAITHU ALERT - FASTAPI BACKEND CONFIGURATION (.env.example)
# ========================================================

# General Configuration
PROJECT_NAME="Raithu Alert - Kadlur Weather Monitoring"
API_V1_PREFIX="/api/v1"
PORT=8000

# CORS Origins (Comma-separated URLs allowed to connect)
# In production on Render, set this to your Vercel deployment URL
CORS_ORIGINS=["https://raithu-alert.vercel.app","http://localhost:3000","http://localhost:5173"]

# --------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="sqlite:///./kadlur_weather.db"
# Production (Render PostgreSQL / Supabase):
# DATABASE_URL="postgresql://user:password@hostname:5432/kadlur_weather"

# --------------------------------------------------------
# ESSENTIAL WEATHER SOURCES (100% Free - No API Keys Needed)
# --------------------------------------------------------
# 1. Open-Meteo High-Resolution NWP (ECMWF / GFS assimilation grid)
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"

# 2. RainViewer Doppler Radar (IMD Hyderabad Begumpet DWR composite)
RAINVIEWER_API_URL="https://api.rainviewer.com/public/weather-maps.json"

# --------------------------------------------------------
# OPTIONAL WEATHER SOURCES (Requires commercial/custom credentials)
# --------------------------------------------------------
# Windy Point Forecast API (Optional - leave empty if not used)
WINDY_API_KEY=""

# Meteomatics 90m Atmospheric Downscaling (Optional - leave empty if not used)
METEOMATICS_USERNAME=""
METEOMATICS_PASSWORD=""

# IMD Direct AWS Telemetry (Optional - official credentials required)
IMD_CUSTOM_KEY=""

# --------------------------------------------------------
# WEB PUSH NOTIFICATIONS & ADMIN
# --------------------------------------------------------
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U"
VAPID_PRIVATE_KEY=""
VAPID_CLAIM_EMAIL="admin@kadlur-weather.org"
ADMIN_API_KEY="kadlur_admin_secret_2026"

# --------------------------------------------------------
# GEOGRAPHICAL REFERENCE: KADLUR VILLAGE, RAICHUR
# --------------------------------------------------------
KADLUR_LATITUDE=16.3768
KADLUR_LONGITUDE=77.2870
